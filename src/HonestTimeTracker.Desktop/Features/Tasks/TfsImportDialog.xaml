<Window x:Class="HonestTimeTracker.Desktop.Features.Tasks.TfsImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from TFS"
        Width="1120" Height="640"
        MinWidth="800" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="CellTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="New work items assigned to you"
                   Style="{StaticResource HeaderText}"
                   FontSize="18"
                   Margin="0,0,0,12" />

        <!-- Sync summary: closed / skipped tasks and collection errors -->
        <Border Grid.Row="1"
                Background="#FFFDE7"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" />
            </ScrollViewer>
        </Border>

        <!-- Bulk actions -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Select all"
                    Padding="12,6"
                    Background="#E0E0E0"
                    Foreground="Black"
                    Margin="0,0,8,0"
                    Command="{Binding SelectAllCommand}" />
            <Button Content="Select none"
                    Padding="12,6"
                    Background="#E0E0E0"
                    Foreground="Black"
                    Margin="0,0,24,0"
                    Command="{Binding SelectNoneCommand}" />
            <TextBlock Text="Set project for selected:"
                       VerticalAlignment="Center"
                       Foreground="#555555"
                       Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding BulkProject}"
                      DisplayMemberPath="Name"
                      Width="220"
                      Padding="6,4"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0" />
            <Button Content="Apply"
                    Padding="12,6"
                    Command="{Binding ApplyBulkProjectCommand}" />
        </WrapPanel>

        <!-- Candidates grouped by collection -->
        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <ListView ItemsSource="{Binding RowsView}" BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F5" Padding="8,6" Margin="0,4,0,2">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="—" Foreground="#757575" />
                                        <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="#757575" />
                                        <Run Text="work item(s)" Foreground="#757575" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Add" Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="TFS #" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WorkItemId}" HorizontalAlignment="Right" Foreground="#555555" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Type" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WorkItemType}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WorkItemType}" Value="Bug">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="TFS project" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TeamProject}" Foreground="#555555" TextTrimming="CharacterEllipsis" ToolTip="{Binding TeamProject}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Title" Width="360">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="345">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource CellTextBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTitleError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#C62828" />
                                                        <Setter Property="ToolTip" Value="Title is required (max 500 characters)." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Project" Width="210">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- The theme ComboBox template ignores BorderBrush, so the error frame is an outer Border -->
                                    <Border Width="195" BorderThickness="2" CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProjectError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#C62828" />
                                                        <Setter Property="ToolTip" Value="Select a project." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ComboBox ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedProject}"
                                                  DisplayMemberPath="Name"
                                                  Padding="4,3" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Planned [h]" Width="85">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding PlannedHoursText, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalContentAlignment="Right">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource CellTextBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPlannedError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#C62828" />
                                                        <Setter Property="ToolTip" Value="Planned time must be a non-negative number of hours." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Today" Width="55">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsOnTodayList, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock Text="{Binding SelectionText}"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#555555" />
            <Button Content="Import selected"
                    DockPanel.Dock="Right"
                    MinWidth="140"
                    Padding="16,8"
                    IsEnabled="{Binding CanImport}"
                    Click="Import_Click" />
            <Button Content="Cancel"
                    DockPanel.Dock="Right"
                    Width="90"
                    Background="#E0E0E0"
                    Foreground="Black"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
        </DockPanel>
    </Grid>
</Window>
