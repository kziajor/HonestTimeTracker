<Window x:Class="HonestTimeTracker.Desktop.Features.Settings.TfsCollectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TFS collection"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText"
                   Text="New TFS collection"
                   Style="{StaticResource HeaderText}"
                   FontSize="18"
                   Margin="0,0,0,20" />

        <TextBlock Text="Name" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox"
                 Padding="8,6"
                 FontSize="14"
                 BorderBrush="#CCCCCC"
                 BorderThickness="1"
                 Margin="0,0,0,16" />

        <TextBlock Text="Collection URL" Margin="0,0,0,6" />
        <TextBox x:Name="UrlBox"
                 Padding="8,6"
                 FontSize="14"
                 BorderBrush="#CCCCCC"
                 BorderThickness="1"
                 Margin="0,0,0,4" />
        <TextBlock Text="e.g. https://tfs.company.com/tfs/DefaultCollection"
                   Foreground="#666666"
                   FontSize="12"
                   Margin="0,0,0,16" />

        <TextBlock Text="Personal access token" Margin="0,0,0,6" />
        <PasswordBox x:Name="PatBox"
                     Padding="8,6"
                     FontSize="14"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Margin="0,0,0,4" />
        <TextBlock x:Name="PatHintText"
                   Text="Required scope: Work Items (Read). The token is encrypted for your Windows account."
                   Foreground="#666666"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <CheckBox x:Name="EnabledCheckBox"
                  Content="Enabled (include in TFS sync)"
                  IsChecked="True"
                  Margin="0,0,0,16" />

        <DockPanel Margin="0,0,0,20" LastChildFill="True">
            <Button x:Name="TestButton"
                    Content="Test connection"
                    DockPanel.Dock="Left"
                    Padding="12,6"
                    Background="#E0E0E0"
                    Foreground="Black"
                    Click="Test_Click" />
            <TextBlock x:Name="TestResultText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="12,0,0,0" />
        </DockPanel>

        <TextBlock x:Name="ErrorText"
                   Foreground="#C62828"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Background="#E0E0E0"
                    Foreground="Black"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button x:Name="OkButton"
                    Content="Save"
                    MinWidth="110"
                    Padding="16,8"
                    Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
