<UserControl x:Class="HonestTimeTracker.Desktop.Features.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
        <StackPanel Margin="0,0,320,0">

            <TextBlock Text="Settings"
                       Style="{StaticResource HeaderText}"
                       FontSize="18"
                       Margin="0,0,0,24" />

            <!-- Daily work hours -->
            <TextBlock Text="Daily work hours"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Standard number of hours you work per day (used for overtime/deficit reports)."
                       Foreground="#666666"
                       FontSize="12"
                       Margin="0,0,0,8" />
            <TextBox x:Name="DailyWorkHoursBox"
                     Text="{Binding DailyWorkHours, UpdateSourceTrigger=PropertyChanged}"
                     Width="160"
                     HorizontalAlignment="Left"
                     Padding="8,6"
                     FontSize="14"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Margin="0,0,0,24" />

            <!-- Default task planned hours -->
            <TextBlock Text="Default task planned time (hours)"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="When adding a new task, the planned time field will be pre-filled with this value. Leave empty to start with 0."
                       Foreground="#666666"
                       FontSize="12"
                       Margin="0,0,0,8" />
            <TextBox x:Name="DefaultTaskPlannedHoursBox"
                     Text="{Binding DefaultTaskPlannedHours, UpdateSourceTrigger=PropertyChanged}"
                     Width="160"
                     HorizontalAlignment="Left"
                     Padding="8,6"
                     FontSize="14"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Margin="0,0,0,32" />

            <!-- Floating timer -->
            <TextBlock Text="Floating timer window"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Show a compact always-on-top window while a timer is running."
                       Foreground="#666666"
                       FontSize="12"
                       Margin="0,0,0,8" />
            <CheckBox Content="Show floating timer"
                      IsChecked="{Binding ShowFloatingTimer}"
                      Margin="0,0,0,32" />

            <!-- Diagnostics -->
            <TextBlock Text="Diagnostics"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Verbose logging writes full TFS requests and responses to the log (tokens are never logged)."
                       Foreground="#666666"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                <CheckBox Content="Verbose TFS logging"
                          IsChecked="{Binding VerboseTfsLogging}"
                          VerticalAlignment="Center"
                          Margin="0,0,24,0" />
                <Button Content="Open log folder"
                        Padding="12,6"
                        Background="#E0E0E0"
                        Foreground="Black"
                        Command="{Binding OpenLogFolderCommand}" />
            </StackPanel>

            <!-- Save button -->
            <Button Content="Save settings"
                    Width="140"
                    HorizontalAlignment="Left"
                    Padding="16,8"
                    Command="{Binding SaveCommand}" />

        </StackPanel>

            <!-- TFS collections (saved immediately, independent of "Save settings") -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,32,0,0" Padding="0,24,0,0">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                        <TextBlock Text="TFS collections"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center" />
                        <Button Content="+ Add collection"
                                DockPanel.Dock="Right"
                                Padding="16,8"
                                Command="{Binding AddCollectionCommand}" />
                    </DockPanel>
                    <TextBlock Text="Azure DevOps Server collections used by &quot;Sync with TFS&quot;. Each collection uses its own personal access token. Changes are saved immediately."
                               Foreground="#666666"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <ListView ItemsSource="{Binding TfsCollections}"
                                  BorderThickness="0"
                                  MinHeight="80"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="URL" Width="300">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Url}" Foreground="#555555" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="PAT" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="—" />
                                                            <Setter Property="Foreground" Value="#C62828" />
                                                            <Setter Property="ToolTip" Value="Token not set" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPat}" Value="True">
                                                                    <Setter Property="Text" Value="✔" />
                                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                                    <Setter Property="ToolTip" Value="Token set" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Enabled" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Status" Width="260">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="#757575" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TestState}" Value="Succeeded">
                                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TestState}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="#C62828" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Actions" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">

                                                    <!-- Test connection (activity) — żółty -->
                                                    <Button Style="{StaticResource IconButtonPrimary}"
                                                            ToolTip="Test connection"
                                                            Margin="0,0,4,0"
                                                            Command="{Binding DataContext.TestCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="15" Height="15">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                                                      Data="M22 12h-4l-3 9L9 3l-3 9H2"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>

                                                    <!-- Edytuj (pencil) — szary -->
                                                    <Button Style="{StaticResource IconButtonNeutral}"
                                                            ToolTip="Edit"
                                                            Margin="0,0,4,0"
                                                            Command="{Binding DataContext.EditCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="15" Height="15">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Stroke="#444444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                                                      Data="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                                                <Path Stroke="#444444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                                                      Data="M15 5l4 4"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>

                                                    <!-- Usuń (trash-2) — czerwony -->
                                                    <Button Style="{StaticResource IconButtonDanger}"
                                                            ToolTip="Delete collection"
                                                            Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Width="15" Height="15">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                                                      Data="M3 6h18"/>
                                                                <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                                                      Data="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                                                <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                                                      Data="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                                                <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                                                      Data="M10 11v6"/>
                                                                <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                                                      Data="M14 11v6"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>

                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
